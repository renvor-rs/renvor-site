{
  "name": "renvor-runtime-spectrum",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "test:a11y": "playwright test",
    "check:links": "lychee --config lychee.toml --root-dir \"$PWD/build\" --no-progress 'build/**/*.html'",
    "validate": "pnpm run typecheck && pnpm run build && pnpm run test:a11y && pnpm run check:links"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@gsap/react": "2.1.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.31.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "4.13.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0"
  },
  "packageManager": "pnpm@11.21.0"
}
