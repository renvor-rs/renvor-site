{
  "name": "renvor-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "csp": "node scripts/generate-csp.mjs",
    "serve": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "test:a11y": "playwright test",
    "test:csp-control": "CSP_CONTROL=1 A11Y_PORT=3211 playwright test --project=csp-control",
    "check:links": "lychee --config lychee.toml --root-dir \"$PWD/out\" --no-progress 'out/**/*.html'",
    "validate": "pnpm run typecheck && pnpm run build && pnpm run csp && pnpm run test:a11y && pnpm run test:csp-control && pnpm run check:links"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "axe-core": "4.13.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0"
  },
  "packageManager": "pnpm@11.21.0"
}
